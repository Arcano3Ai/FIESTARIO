# FIESTARIO - Environment Variables
# Base de Datos
DATABASE_URL="postgresql://postgres:password@localhost:5432/fiestario?schema=public"

# Autenticación (Auth.js / NextAuth)
AUTH_SECRET="your-super-secret-auth-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3005"

# Almacenamiento (S3 Compatible / Cloudflare R2 / AWS S3)
STORAGE_URL="https://storage.fiestario.mx"
STORAGE_KEY="your-storage-access-key"
STORAGE_SECRET="your-storage-secret-key"
STORAGE_BUCKET="fiestario-assets"

# Pagos (Stripe México)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Inteligencia Artificial (OpenAI / Claude para Planeador IA)
AI_API_KEY="sk-..."

# Mapas & Geolocalización (Mapbox / Google Maps)
MAPS_API_KEY="pk.eyJ1I..."

# Email Transaccional (Resend)
EMAIL_API_KEY="re_..."

# Analítica y Telemetría (PostHog / GA4)
ANALYTICS_KEY="phc_..."
